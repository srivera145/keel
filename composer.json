{
    "name": "santosrivera/keel",
    "description": "Santos Rivera's PHP framework: MVC structure, OTP + Magic Link auth, mailer, and routing.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "phpmailer/phpmailer": "^6.9",
        "stripe/stripe-php": "^20.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Keel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test:db": "php scripts/setup_test_db.php",
        "test:feature": [
            "@test:db",
            "vendor/bin/phpunit --testsuite Feature"
        ],
        "test:all": [
            "@test:db",
            "vendor/bin/phpunit"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
